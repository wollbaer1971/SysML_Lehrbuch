\begin{tikzpicture}[
    scale=0.62, transform shape,
    every node/.style={font=\small},
    reqbox/.style={
        rectangle, rounded corners=2pt, draw=black!70, thick,
        minimum width=32mm, minimum height=11mm,
        align=center, fill=blue!12, drop shadow
    },
    archbox/.style={
        rectangle, rounded corners=2pt, draw=green!40!black, thick,
        minimum width=32mm, minimum height=11mm,
        align=center, fill=green!15, drop shadow
    },
    implbox/.style={
        rectangle, rounded corners=2pt, draw=orange!60!black, thick,
        minimum width=32mm, minimum height=11mm,
        align=center, fill=orange!15, drop shadow
    },
    testbox/.style={
        rectangle, rounded corners=2pt, draw=black!50, thick,
        minimum width=32mm, minimum height=11mm,
        align=center, fill=black!6, drop shadow
    },
    flow/.style={-{Stealth[length=2.2mm]}, thick, black!60},
    corr/.style={dashed, thick, black!50},
    lbl/.style={font=\small, fill=white, inner sep=1pt}
]

% --- left branch: specification (descending) ---
% Note: spacing chosen so boxes (width 32mm) never overlap at any level;
% the horizontal offset from the center axis (x=7) grows by 2cm per level,
% so even the tightest level (comp/unit, offset 2cm, distance 4cm) has more
% spacing than the box width.
\node[reqbox]  (stake) at (-1, 12) {Stakeholder\\Needs};
\node[reqbox]  (sysreq) at (1, 9)  {System\\Requirements};
\node[archbox] (arch)  at (3, 6)  {Architecture/\\Design};
\node[archbox] (comp)  at (5, 3)  {Component\\Design};

% --- tip ---
\node[implbox] (impl) at (7, 0) {Implementation};

% --- right branch: verification (ascending) ---
\node[testbox] (unit)  at (9, 3)  {Unit Test};
\node[testbox] (integ) at (11, 6) {Integration\\Test};
\node[testbox] (systest) at (13, 9) {System Test};
\node[testbox] (valid) at (15, 12) {Acceptance/\\Validation Test};

% --- descending branch ---
\draw[flow] (stake)  -- (sysreq);
\draw[flow] (sysreq) -- (arch);
\draw[flow] (arch)   -- (comp);
\draw[flow] (comp)   -- (impl);

% --- ascending branch ---
\draw[flow] (impl)    -- (unit);
\draw[flow] (unit)    -- (integ);
\draw[flow] (integ)   -- (systest);
\draw[flow] (systest) -- (valid);

% --- horizontal correspondences (dashed, no arrowhead) ---
\draw[corr] (stake)  -- node[lbl, midway]{validates}   (valid);
\draw[corr] (sysreq) -- node[lbl, midway]{verifies} (systest);
\draw[corr] (arch)   -- (integ);
\draw[corr] (comp)   -- (unit);

% --- margin labels ---
\node[font=\small, rotate=90, black!70] at (-3.4, 6) {Specification};
\node[font=\small, rotate=-90, black!70] at (17.4, 6) {Verification};
\node[font=\small, black!70] at (7, -2.2) {Implementation};

% --- legend ---
\node[reqbox,  minimum width=6mm, minimum height=4mm, font=\small] (leg1) at (1,-5) {};
\node[right=1mm of leg1, font=\small, align=left] (lab1){Requirement};
\node[archbox, minimum width=6mm, minimum height=4mm, font=\small, right=6mm of lab1] (leg2) {};
\node[right=1mm of leg2, font=\small, align=left] (lab2){Architecture/Design};
\node[implbox, minimum width=6mm, minimum height=4mm, font=\small, right=6mm of lab2] (leg3) {};
\node[right=1mm of leg3, font=\small, align=left] (lab3){Implementation};
\node[testbox, minimum width=6mm, minimum height=4mm, font=\small, right=6mm of lab3] (leg4) {};
\node[right=1mm of leg4, font=\small, align=left] (lab4){Test level};

\end{tikzpicture}
