\begin{tikzpicture}[node distance=1.6cm]
\node (stakeholder) [draw, rounded corners] {Stakeholder};
\node (req) [draw, rounded corners, right of=stakeholder, xshift=2.7cm] {Requirement};
\node (func) [draw, rounded corners, right of=req, xshift=3.5cm] {Function};
\node (arch) [draw, rounded corners, below of=func, yshift=-0.4cm] {System Element};
\node (test) [draw, rounded corners, left of=arch, xshift=-3.5cm] {Test Case};
\draw[->] (stakeholder) -- node[above] {\small need} (req);
\draw[->] (req) -- node[above] {\small satisfied by} (func);
\draw[->] (func) -- node[right] {\small realized by} (arch);
\draw[->] (test) -- node[right] {\small verifies} (req);
\end{tikzpicture}
